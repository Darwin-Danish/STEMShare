<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Math Pop!</title>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Fredoka One', cursive;
      background: linear-gradient(135deg, #89f7fe, #66a6ff);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
    }
    .game-container {
      background: white;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      padding: 2rem;
      text-align: center;
      width: 300px;
    }
    h1 {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: #333;
    }
    .question {
      font-size: 1.5rem;
      margin: 1rem 0;
    }
    input[type='number'] {
      padding: 0.5rem;
      font-size: 1.2rem;
      width: 100%;
      margin-bottom: 1rem;
    }
    button {
      background-color: #66a6ff;
      color: white;
      padding: 0.5rem 1rem;
      font-size: 1rem;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }
    button:hover {
      background-color: #558ed1;
    }
    .score {
      font-size: 1.2rem;
      margin-top: 1rem;
      color: #444;
    }
    .hidden {
      display: none;
    }
  </style>
</head>
<body>
  <div class="game-container">
    <h1>Math Pop!</h1>
    <div id="game">
      <div class="question" id="question"></div>
      <input type="number" id="answer" placeholder="Your answer" />
      <button onclick="submitAnswer()">Submit</button>
      <div class="score">Score: <span id="score">0</span></div>
    </div>
    <div id="endGame" class="hidden">
      <p>🎉 Game Over!</p>
      <p>Your Final Score: <span id="finalScore"></span></p>
      <input type="text" id="playerName" placeholder="Enter your name" />
      <button onclick="saveScore()">Save Score</button>
    </div>
  </div>

  <script>
    let num1, num2, score = 0, rounds = 0, maxRounds = 5;

    function generateQuestion() {
      num1 = Math.floor(Math.random() * 10 + 1);
      num2 = Math.floor(Math.random() * 10 + 1);
      document.getElementById('question').innerText = `${num1} + ${num2} = ?`;
    }

    function submitAnswer() {
      const answer = parseInt(document.getElementById('answer').value);
      if (answer === num1 + num2) {
        score++;
      }
      rounds++;
      document.getElementById('score').innerText = score;
      document.getElementById('answer').value = '';

      if (rounds >= maxRounds) {
        endGame();
      } else {
        generateQuestion();
      }
    }

    function endGame() {
      document.getElementById('game').classList.add('hidden');
      document.getElementById('endGame').classList.remove('hidden');
      document.getElementById('finalScore').innerText = score;
    }

    function saveScore() {
      const name = document.getElementById('playerName').value || 'Anonymous';
      const saved = localStorage.getItem('mathPopScores') || '[]';
      const scores = JSON.parse(saved);
      scores.push({ name, score });
      localStorage.setItem('mathPopScores', JSON.stringify(scores));
      alert('Score saved! Thank you for playing!');
      location.reload();
    }

    generateQuestion();
  </script>
</body>
</html>
